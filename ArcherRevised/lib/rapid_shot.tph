// Native Archer Revised implementation of Rapid Shot.
// Uses opcode 183 so the APR bonus is only active while a bow or crossbow is equipped.

COPY ~%MOD_FOLDER%/spells/AR#RAPI.SPL~ ~override~
  SAY NAME1 @3000
  SAY UNIDENTIFIED_DESC @3001

COPY ~%MOD_FOLDER%/spells/AR#RONA.SPL~ ~override~
  SAY NAME1 @3002
  SAY UNIDENTIFIED_DESC @3003

COPY ~%MOD_FOLDER%/spells/AR#ROFF.SPL~ ~override~
  SAY NAME1 @3004
  SAY UNIDENTIFIED_DESC @3005

COPY ~%MOD_FOLDER%/spells/AR#RAPI.2da~ ~override~
COPY ~%MOD_FOLDER%/spells/AR#APR1.EFF~ ~override~
COPY ~%MOD_FOLDER%/spells/AR#TH4.EFF~ ~override~
COPY ~%MOD_FOLDER%/spells/AR#TH2.EFF~ ~override~
