// Archer Revised - native Manyshot progression.
//
// Artisan's implementation relies on custom combat-round animations and patches
// every bow/crossbow. Archer Revised deliberately uses a compatibility-first
// mechanical equivalent: +1/2 APR at levels 7, 13 and 20 while a bow or
// crossbow is equipped. The three independent resources stack to +1.5 APR.

ACTION_FOR_EACH ms_level IN 07 13 20 BEGIN
  COPY ~%MOD_FOLDER%/spells/AR#APR1.EFF~ ~override/ARMSH%ms_level%.EFF~
    // Opcode 1 key 6 = +0.5 APR.
    WRITE_LONG 0x1c 6
    WRITE_ASCII 0x94 ~ARMSH%ms_level%~ #8
  BUT_ONLY

  COPY ~%MOD_FOLDER%/kit/a7#ins1.spl~ ~override/ARMSH%ms_level%.SPL~
    LPF DELETE_SPELL_EFFECT INT_VAR opcode_to_delete = (0 - 1) END

    // Bow
    LPF ADD_SPELL_EFFECT
      INT_VAR
        opcode         = 183
        target         = 2
        parameter1     = 0
        parameter2     = 15
        timing         = 9
        resist_dispel  = 2
      STR_VAR
        resource       = ~ARMSH%ms_level%~
    END

    // Crossbow
    LPF ADD_SPELL_EFFECT
      INT_VAR
        opcode         = 183
        target         = 2
        parameter1     = 0
        parameter2     = 27
        timing         = 9
        resist_dispel  = 2
      STR_VAR
        resource       = ~ARMSH%ms_level%~
    END
  BUT_ONLY
END
