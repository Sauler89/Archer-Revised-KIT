// Archer Revised - compatibility-first Manyshot progression.
//
// True Manyshot in Artisan creates extra independently-rolled projectiles and
// therefore has to patch individual launchers. Archer Revised keeps the safer
// compatibility-first model but now uses an item-driven implementation too,
// so it can be refreshed after mods add new bows/crossbows.
//
// While an Archer has a patched bow or crossbow equipped:
//   level 7  : +25% total missile damage
//   level 13 : +40% total (+15% additional)
//   level 20 : +60% total (+20% additional)
//
// Opcode 332: Specific Damage Modifier, type 10 = Missile.
// The EFF minimum-level fields phase each bonus in automatically.

COPY ~%MOD_FOLDER%/spells/AR#APR1.EFF~ ~override/ARMSH07.EFF~
  WRITE_LONG 0x10 332
  WRITE_LONG 0x1c 25
  WRITE_LONG 0x20 10
  WRITE_LONG 0x54 7
  WRITE_LONG 0x58 0
  WRITE_LONG 0x5c 2
  WRITE_LONG 0x90 0
  WRITE_ASCII 0x94 ~ARMSH07~ #8
BUT_ONLY

COPY ~%MOD_FOLDER%/spells/AR#APR1.EFF~ ~override/ARMSH13.EFF~
  WRITE_LONG 0x10 332
  WRITE_LONG 0x1c 15
  WRITE_LONG 0x20 10
  WRITE_LONG 0x54 13
  WRITE_LONG 0x58 0
  WRITE_LONG 0x5c 2
  WRITE_LONG 0x90 0
  WRITE_ASCII 0x94 ~ARMSH13~ #8
BUT_ONLY

COPY ~%MOD_FOLDER%/spells/AR#APR1.EFF~ ~override/ARMSH20.EFF~
  WRITE_LONG 0x10 332
  WRITE_LONG 0x1c 20
  WRITE_LONG 0x20 10
  WRITE_LONG 0x54 20
  WRITE_LONG 0x58 0
  WRITE_LONG 0x5c 2
  WRITE_LONG 0x90 0
  WRITE_ASCII 0x94 ~ARMSH20~ #8
BUT_ONLY

// Patch every bow/crossbow currently present. Component 10 can repeat this
// later after content mods have added more launchers.
INCLUDE ~%MOD_FOLDER%/lib/manyshot_items.tph~
