// Archer Revised core rules.

// d8 Hit Die table.
COPY ~%MOD_FOLDER%/2da/HPARCH.2da~ ~override/HPARCH.2da~

// Point the Archer kit at the d8 table without assuming whether the game
// identifies the kit row as FERALAN or ARCHER.
COPY_EXISTING ~hpclass.2da~ ~override~
  COUNT_2DA_COLS cols
  READ_2DA_ENTRIES_NOW rows cols
  FOR (row = 0; row < rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER rows row 0 ~kit_name~
    PATCH_IF (~%kit_name%~ STRING_EQUAL_CASE ~FERALAN~ ||
              ~%kit_name%~ STRING_EQUAL_CASE ~ARCHER~) BEGIN
      SET_2DA_ENTRY row 1 cols ~HPARCH~
    END
  END
  PRETTY_PRINT_2DA
BUT_ONLY
