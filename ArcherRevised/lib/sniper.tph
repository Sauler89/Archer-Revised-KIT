// Native Sniper controller. ARSNCHK evaluates the current state and clears
// any previous critical bonus before conditionally applying a fresh one.
COPY ~%MOD_FOLDER%/kit/a7#ins1.spl~ ~override/ARSNIP.SPL~
  LPF DELETE_SPELL_EFFECT INT_VAR opcode_to_delete = (0 - 1) END
  LPF ADD_SPELL_EFFECT
    INT_VAR opcode = 272 target = 2 parameter1 = 1 parameter2 = 0
            timing = 9 resist_dispel = 2
    STR_VAR resource = ~ARSNEFF~
  END
BUT_ONLY
